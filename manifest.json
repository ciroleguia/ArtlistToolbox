{
  "manifest_version": 3,
  "name": "Artlist Toolbox",
  "version": "0.6.0",
  "description": "Artlist library tools plus an optional YouTube MP3 download flow.",
  "permissions": ["tabs", "storage", "contextMenus"],
  "host_permissions": [
    "https://artlist.io/*",
    "https://*.artlist.io/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://y2mate.gs/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://artlist.io/*", "https://*.artlist.io/*"],
      "js": ["src/early-guard.js"],
      "css": ["src/styles.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://artlist.io/*", "https://*.artlist.io/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Artlist Toolbox",
    "default_popup": "popup/popup.html"
  }
}
